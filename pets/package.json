{
  "name": "@guygrigsby/pi-pets",
  "version": "0.1.2",
  "type": "module",
  "description": "A switchable menagerie of coding-agent companions for pi. Each pet is a character with ASCII art, quips, and a matching theme; /pet swaps them, and an optional perch keeps your pet ever-present in the TUI.",
  "keywords": [
    "pi-package",
    "pi",
    "theme",
    "extension",
    "pets",
    "fun"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guygrigsby/pi-extensions.git",
    "directory": "pets"
  },
  "author": {
    "name": "Guy J Grigsby"
  },
  "files": [
    "extensions/",
    "dist/",
    "pets/",
    "generated/",
    "themes/",
    "scripts/",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "test": "node --test"
  },
  "pi": {
    "themes": [
      "./themes"
    ],
    "extensions": [
      "./dist/pets.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  }
}
