{
  "name": "@guygrigsby/pi-promptdump",
  "version": "0.1.1",
  "description": "Dev tool: on every provider request, dump the exact payload pi sends (final system prompt plus messages) to a file so you can see precisely what the model receives.",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "debug",
    "prompt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guygrigsby/pi-extensions.git",
    "directory": "promptdump"
  },
  "author": {
    "name": "Guy J Grigsby"
  },
  "files": [
    "extensions/",
    "tests/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
